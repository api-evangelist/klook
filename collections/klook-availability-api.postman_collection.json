          "request": {
            "name": "Availability Calendar",
            "description": {
              "content": "This endpoint is highly optimised and will return a single object per day. It's designed to be queried for large date ranges and the result is used to populate an availability calendar.\n\nWhen the end user selects an open date you can call on `/availability` endpoint to get the `availabilityId` to create the booking.",
              "type": "text/plain"
            },
            "url": {
